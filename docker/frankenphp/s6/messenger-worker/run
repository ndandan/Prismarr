#!/command/with-contenv sh
sleep 3
# Drop privileges: the messenger worker runs as www-data (UID 82).
# 512M, not 256M: one Bazarr /movies?length=-1 refresh decodes ~5.4k rows
# (~120-180 MB peak). At 256M the consumer would recycle after nearly every
# refresh; php.ini's own memory_limit (1024M) is the real ceiling.
exec s6-setuidgid www-data php /var/www/html/bin/console messenger:consume async --time-limit=3600 --memory-limit=512M -v
