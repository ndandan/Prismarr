includes:
    - phpstan-baseline.neon
    - vendor/phpstan/phpstan-symfony/extension.neon

parameters:
    level: 7
    paths:
        - src
    excludePaths:
        analyse:
            - src/Kernel.php
    ignoreErrors:
        # Missing array value types (`array` instead of `array<string, mixed>`).
        # 812 occurrences, none of them correctness bugs — this is annotation
        # debt, deliberately deferred to the `declare(strict_types=1)` /
        # annotation sweep. Ignored rather than baselined on purpose: a
        # baseline would make every NEW file fail CI for the same debt while
        # adding no safety, which is exactly the pressure that leads to
        # regenerating baselines.
        -
            identifier: missingType.iterableValue
        # BazarrSubtitleIndex::__construct() keeps $client/$cacheApp as its
        # first two positional parameters purely so existing call sites (and
        # the brief-mandated test helper `index($client, $pool, ...)`) only
        # need the two NEW arguments (StaleWhileRevalidateCache, Logger)
        # appended, not a full rewrite. Every read now goes through the SWR
        # cache instead — the badge path must never call the client directly
        # (enforced by a source-sentinel test) — so both params are
        # deliberately unused in this class today; a later task in the same
        # programme (perf-bazarr-responsiveness) may give them a real use.
        -
            identifier: constructor.unusedParameter
            path: src/Service/Media/BazarrSubtitleIndex.php
            count: 2
