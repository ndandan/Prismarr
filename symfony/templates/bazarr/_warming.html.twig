{#
  Cold-cache state: the messenger worker has been asked for a rebuild and we
  are waiting. Exactly ONE automatic retry, then a manual button — a looping
  auto-retry against a down Bazarr is a self-inflicted DoS.

  This inline script runs both on a full page render and inside a frame swap:
  Turbo's FrameRenderer re-creates script elements, so it does not need the
  delegated-listener treatment the innerHTML-swapped dashboard widgets need.

  JS comments in here open with slash-star and close with star-slash. A `{#`
  opened comment closed with `#}` inside a script block once shipped a dead
  modal; BazarrTemplateGuardTest now balances them.
#}
<div class="empty py-5" id="bazarr-warming">
  <div class="empty-icon"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>
  <p class="empty-title">{{ 'bazarr.warming.title'|trans }}</p>
  <p class="empty-subtitle text-secondary">{{ 'bazarr.warming.subtitle'|trans }}</p>
  <div class="empty-action">
    <button type="button" class="btn btn-primary d-none" id="bazarr-warming-retry">{{ 'bazarr.warming.retry'|trans }}</button>
  </div>
</div>
<script>
(function () {
  var el = document.getElementById('bazarr-warming');
  if (!el || el._bzWarmInit) { return; }
  el._bzWarmInit = true;

  var btn = document.getElementById('bazarr-warming-retry');
  var frame = document.getElementById('bazarr-view');
  var path = window.location.pathname + window.location.search;
  var storageKey = 'prismarr:bazarr-warm-retried:' + path;

  /* The server always re-renders this markup with no memory of a prior
     retry (there is nothing to read it back FROM — the cache is still
     cold), so "have we already auto-retried" cannot live in the HTML.

     It lives in sessionStorage, keyed by path, so ONE entry survives both
     a Turbo frame swap AND the window.location.reload() fallback below —
     the fallback is a full document navigation, which wipes any plain
     `window` property, so a window-only flag would forget it had already
     retried and re-arm a fresh 4 s timer on every reload: an infinite
     retry loop against a Bazarr that never comes back, in exactly the
     browsers/contexts that need the fallback. `window` is kept as the
     fallback for when sessionStorage itself throws (private browsing,
     disabled storage, a quota error) — worse-bounded (a full navigation
     still resets it) but never worse than before this fix. */
  function hasRetried() {
    try {
      if (window.sessionStorage) { return sessionStorage.getItem(storageKey) === '1'; }
    } catch (e) { /* fall through to the window fallback below */ }

    return !!(window.__bzWarmRetried && window.__bzWarmRetried[path]);
  }

  function markRetried() {
    try {
      if (window.sessionStorage) { sessionStorage.setItem(storageKey, '1'); return; }
    } catch (e) { /* fall through to the window fallback below */ }

    window.__bzWarmRetried = window.__bzWarmRetried || {};
    window.__bzWarmRetried[path] = true;
  }

  function reloadView() {
    /* frame.reload() is a no-op when the frame has no `src` yet — true on
       a direct hit / full-page render, since the shell ships this markup
       as the frame's initial server-rendered content rather than fetching
       it. Turbo.visit(url, {frame}) instead ASSIGNS the frame's `src`,
       which works whether or not one was already set. */
    if (frame && window.Turbo && typeof window.Turbo.visit === 'function') {
      window.Turbo.visit(path, { frame: 'bazarr-view' });
    } else {
      window.location.reload();
    }
  }

  var timer = null;
  if (hasRetried()) {
    // Already auto-retried once this session for this view: skip straight
    // to the manual button instead of reloading (and re-arming a new 4 s
    // timer) again.
    if (btn) { btn.classList.remove('d-none'); }
  } else {
    /* One automatic retry, ~4 s out: long enough for a queued refresh (the
       consumer polls once a second) plus the Bazarr fetch itself. */
    timer = setTimeout(function () {
      markRetried();
      if (btn) { btn.classList.remove('d-none'); }
      reloadView();
    }, 4000);
  }

  if (btn) {
    btn.addEventListener('click', function () {
      btn.disabled = true;
      /* Force an inline, breaker-gated rebuild — this is the recovery path
         when the messenger worker itself is down. */
      fetch({{ path('app_bazarr_api_refresh')|json_encode|raw }}, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        credentials: 'same-origin'
      }).then(function () { reloadView(); })
        .catch(function () { btn.disabled = false; });
    });
  }

  // Dual-bound like _grid.html.twig's teardown: a frame swap fires
  // turbo:before-frame-render on the frame element and NO document-level
  // turbo:before-render; a full-page Turbo Drive visit fires only the
  // latter. Removing both from one teardown, regardless of which fired,
  // keeps this idempotent.
  function teardown() {
    if (timer) { clearTimeout(timer); timer = null; }
    if (frame) { frame.removeEventListener('turbo:before-frame-render', teardown); }
    document.removeEventListener('turbo:before-render', teardown);
  }
  if (frame) { frame.addEventListener('turbo:before-frame-render', teardown); }
  document.addEventListener('turbo:before-render', teardown);
})();
</script>
