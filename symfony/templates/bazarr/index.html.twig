{% extends 'base.html.twig' %}

{% block title %}{{ 'bazarr.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="page-header d-print-none">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">{{ 'bazarr.title'|trans }}</h2>
      <div class="text-secondary">{{ 'bazarr.subtitle'|trans }}</div>
    </div>
    <div class="col-auto ms-auto">
      {% include 'bazarr/_nav.html.twig' %}
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">

    {% if error %}
      {% include 'error/_service_banner.html.twig' with { service: 'Bazarr', wizard_route: 'admin_settings_index', configured_url: service_url, reason: 'unreachable' } %}
    {% else %}
      <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-4">
          <div class="card card-sm">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-auto">
                  <span class="bg-primary text-white avatar">{{ counts.movies }}</span>
                </div>
                <div class="col">
                  <div class="text-secondary">{{ 'bazarr.stat.movies_wanted'|trans }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-lg-4">
          <div class="card card-sm">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-auto">
                  <span class="bg-azure text-white avatar">{{ counts.episodes }}</span>
                </div>
                <div class="col">
                  <div class="text-secondary">{{ 'bazarr.stat.episodes_wanted'|trans }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-sm-6 col-lg-4">
          <div class="card card-sm">
            <div class="card-body">
              <div class="row align-items-center">
                <div class="col-auto">
                  <span class="bg-green text-white avatar">{{ counts.providers }}</span>
                </div>
                <div class="col">
                  <div class="text-secondary">{{ 'bazarr.stat.providers'|trans }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row row-cards">
        <div class="col-lg-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">{{ 'bazarr.wanted.movies_title'|trans }}</h3>
            </div>
            {% if wanted_movies is empty %}
              <div class="card-body">
                <div class="empty">
                  <p class="empty-title">{{ 'bazarr.wanted.empty'|trans }}</p>
                </div>
              </div>
            {% else %}
              <div class="table-responsive">
                <table class="table table-vcenter card-table">
                  <thead>
                    <tr>
                      <th>{{ 'bazarr.wanted.column_title'|trans }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for item in wanted_movies %}
                      <tr>
                        <td>{{ item.title|default(item.name|default('—')) }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">{{ 'bazarr.wanted.episodes_title'|trans }}</h3>
            </div>
            {% if wanted_episodes is empty %}
              <div class="card-body">
                <div class="empty">
                  <p class="empty-title">{{ 'bazarr.wanted.empty'|trans }}</p>
                </div>
              </div>
            {% else %}
              <div class="table-responsive">
                <table class="table table-vcenter card-table">
                  <thead>
                    <tr>
                      <th>{{ 'bazarr.wanted.column_title'|trans }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for item in wanted_episodes %}
                      <tr>
                        <td>{{ item.seriesTitle|default(item.title|default('—')) }} {{ item.episode_number|default('') }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</div>
{% endblock %}
