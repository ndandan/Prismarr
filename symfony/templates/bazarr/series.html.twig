{% extends 'base.html.twig' %}

{% block title %}{{ 'bazarr.title'|trans }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="page-header d-print-none">
  <div class="row align-items-center">
    <div class="col">
      <h2 class="page-title">{{ 'bazarr.title'|trans }}</h2>
      <div class="text-secondary">{{ 'bazarr.subtitle'|trans }}</div>
    </div>
    <div class="col-auto ms-auto">
      {% include 'bazarr/_nav.html.twig' %}
    </div>
  </div>
</div>

<div class="page-body">
  <div class="container-xl">

    {% if error %}
      {% include 'error/_service_banner.html.twig' with { service: 'Bazarr', wizard_route: 'admin_settings_index', configured_url: service_url, reason: 'unreachable' } %}
    {% else %}
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">{{ 'bazarr.series.title'|trans }}</h3>
        </div>
        {% if series is empty %}
          <div class="card-body">
            <div class="empty">
              <p class="empty-title">{{ 'bazarr.series.empty'|trans }}</p>
            </div>
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table table-vcenter card-table">
              <thead>
                <tr>
                  <th>{{ 'bazarr.series.column_title'|trans }}</th>
                  <th>{{ 'bazarr.series.column_year'|trans }}</th>
                  <th>{{ 'bazarr.series.column_episodes'|trans }}</th>
                  <th>{{ 'bazarr.series.column_missing'|trans }}</th>
                </tr>
              </thead>
              <tbody>
                {% for serie in series %}
                  <tr>
                    <td>
                      {% if serie.sonarrSeriesId is defined %}
                        <a href="{{ path('app_bazarr_series_detail', { seriesId: serie.sonarrSeriesId }) }}">{{ serie.title|default('—') }}</a>
                      {% else %}
                        {{ serie.title|default('—') }}
                      {% endif %}
                    </td>
                    <td>{{ serie.year|default('—') }}</td>
                    <td>{{ serie.episodeFileCount|default(0) }}</td>
                    <td>
                      {% if serie.episodeMissingCount is defined and serie.episodeMissingCount > 0 %}
                        <span class="badge bg-red-lt">{{ serie.episodeMissingCount }}</span>
                      {% else %}
                        <span class="badge bg-green-lt">{{ 'bazarr.series.none_missing'|trans }}</span>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</div>
{% endblock %}
